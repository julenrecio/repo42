Script		--> monitoring.sh

#!/bin/bash

# CPUs
sockets=$(lscpu | grep 'Socket(s)' | awk '{print $2}')
cores=$(lscpu | grep 'Núcleo(s)' | awk '{print $4}')
threads=$(lscpu | grep 'Hilo(s)' | awk '{print $6}')

# RAM
total_mem=$(free -m | grep Mem | awk '{print $2}')
avail_mem=$(free -m | grep Mem | awk '{print $3}')

# Disk
disk_mem=$(vgdisplay | grep 'Alloc PE' | awk '{print $5}')
free_mem=$(vgdisplay | grep 'Alloc PE' | awk '{print substr($7, 2)}')
ratio_mem=$(df -h --block-size=G --total | tail -n 1 | awk '{print $5}')

# CPU load
cpu=$(mpstat | awk '/all/ {gsub(",", ".", $NF); print 100 - $NF}')

# Last boot
boot=$(who -b | awk '{print $4 " " $5}')

# LVM
lvm=$(cat /etc/fstab | grep /dev/mapper | wc -l)

# TCP
tcp=$(echo "$(ss -t state established | wc -l) - 1" | bc)

# LOG
log=$(($(w | wc -l) - 2))

# NET
ip=$(ip address | grep enp | grep inet | awk '{print $2}' | cut -d / -f1)
mac=$(ip address | grep enp -A 1 | grep ether | awk '{print $2}')

# SUDO
sudo=$(echo "obase=10; ibase=36; $(cat /var/log/sudo/seq)" | bc)

echo -n '#Architecture: ' ; uname -a;
echo -n '#Physical CPU: '; echo $(($sockets*$cores));
echo -n '#vCPU: '; echo $(($sockets*$cores*$threads));
echo -n '#Memory Usage: '; echo -n $avail_mem'/'$total_mem'MB '; echo "($(echo "scale=2; ($avail_mem*100)/$total_mem" | bc)%)";
echo -n '#Disk Usage: '; echo -n $disk_mem'/'$free_mem'GB '; echo $ratio_mem;
echo "#CPU load: $cpu%";
echo "#Last boot: $boot";
echo -n '#LVM use: ';

if [ $lvm -gt 0 ]
then
        echo "yes"
else
        echo "no"
fi

echo "#TCP Connections: $tcp ESTABLISHED";
echo "#User log: $log";
echo "#Network: IP $ip ($mac)";
echo "#Sudo: $sudo";

